# --- Postgres ---
DATABASE_URL=postgresql://sundera:sundera@localhost:5432/sundera

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=sundera-media
S3_FORCE_PATH_STYLE=true

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-image
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- lava.top (apps/api, lifetime purchase checkout + webhooks) ---
LAVA_TOP_API_KEY=
LAVA_TOP_BASE_URL=https://gate.lava.top
# Shared secret for the "API-Key" webhook auth option in lava.top's
# Integration tab — must match exactly what's configured there.
LAVA_TOP_WEBHOOK_SECRET=
# Offer ID (uuid) from the lava.top dashboard for the single lifetime
# offer, configured with a ONE_TIME price.
LAVA_TOP_OFFER_ID_LIFETIME=
LAVA_TOP_CURRENCY=USD

# --- Feedback widget (apps/api, sends submissions via Gmail SMTP) ---
# GMAIL_APP_PASSWORD is a 16-char app password from
# https://myaccount.google.com/apppasswords (requires 2FA on the account) —
# not the account's normal login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
FEEDBACK_TO_EMAIL=info@sundera.app

# --- API (apps/api) ---
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Blog posts (apps/api, written by marketing/blog/'s bot) ---
# Shared secret the blog bot sends as X-Blog-Bot-Secret — must match
# BLOG_BOT_API_SECRET in marketing/blog/.env.
BLOG_BOT_API_SECRET=
# How many posts get a scheduled slot per UTC day, and the window they're
# spread across. Defaults shown.
BLOG_POSTS_PER_DAY=3
BLOG_PUBLISH_WINDOW_START=09:00
BLOG_PUBLISH_WINDOW_END=21:00

# --- Firebase Admin (apps/api, auth token verification) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Hostname only (no protocol/path), e.g. pub-xxxx.r2.dev or cdn.sundera.app —
# the public R2 bucket/domain marketing/blog/'s bot uploads images to.
# Required before any real blog post (not the seed one) can render its image.
NEXT_PUBLIC_BLOG_IMAGE_HOST=

# --- Blog admin (apps/web, /blog-admin — view/edit/publish the queue) ---
# The single shared login password for /blog-admin. Set this in Railway, not
# just locally — see apps/web/src/lib/blog-admin-auth.ts.
BLOG_ADMIN_PASSWORD=
# Must be the exact same value as BLOG_BOT_API_SECRET above — apps/web's
# server-side admin routes authenticate to apps/api as another privileged
# caller under BlogBotGuard, the same trust boundary as marketing/blog/'s
# bot. Server-only: never prefixed NEXT_PUBLIC_, never sent to the browser.
BLOG_BOT_API_SECRET=

# --- Firebase client (apps/web, auth sign-in) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- PostHog (apps/web, product analytics) ---
# Leave NEXT_PUBLIC_POSTHOG_KEY empty to no-op analytics (dev default).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
