# --- Postgres ---
DATABASE_URL=postgresql://sundera:sundera@localhost:5432/sundera

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=sundera-media
S3_FORCE_PATH_STYLE=true

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-image
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- lava.top (apps/api, subscription checkout + webhooks) ---
LAVA_TOP_API_KEY=
LAVA_TOP_BASE_URL=https://gate.lava.top
# Shared secret for the "API-Key" webhook auth option in lava.top's
# Integration tab — must match exactly what's configured there.
LAVA_TOP_WEBHOOK_SECRET=
# Offer IDs (uuid) from the lava.top dashboard, one per paid tier. Each
# offer must have both a MONTHLY and a PERIOD_YEAR price configured, since
# the billing cycle is chosen per-checkout, not per-offer.
LAVA_TOP_OFFER_ID_STARTER=
LAVA_TOP_OFFER_ID_PRO=
LAVA_TOP_CURRENCY=USD

# --- API (apps/api) ---
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Firebase Admin (apps/api, auth token verification) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Firebase client (apps/web, auth sign-in) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
