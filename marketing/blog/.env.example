# Copy to marketing/blog/.env (gitignored) and fill in real values.
# Never commit this file with real secrets, and never paste real values into chat/PRs.

# --- Telegram approval bot (bot.py) ---
# A NEW bot, separate from marketing/pinterest's — create via @BotFather (/newbot) for
# the token; message the bot once, then GET
# https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id out of the response.
# Same steps as marketing/pinterest/CLAUDE.md documents for that bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cloudflare R2 (S3-compatible) — TWO buckets, not one ---
# R2_SOURCE_BUCKET: the Pinterest pack's bucket (R2_BUCKET in
# marketing/pinterest/.env.example) — read-only here, under its existing "pinterest/"
# prefix. Use a read-only-scoped R2 API token for this if possible.
#
# R2_PUBLIC_BUCKET: a SEPARATE bucket, public-read, dedicated to blog images. Must never
# be R2_SOURCE_BUCKET above or apps/api's S3_BUCKET — both of those hold private user
# photos and must never become public. Create it in the Cloudflare dashboard, enable
# public access (either the bucket's public "r2.dev" dev URL, or a custom domain like
# cdn.sundera.app), and set R2_PUBLIC_BASE_URL to that full https:// URL. The same
# hostname (no protocol) also needs to go into apps/web's NEXT_PUBLIC_BLOG_IMAGE_HOST —
# next/image throws on an unconfigured external host.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SOURCE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=

# --- OpenRouter (article copy generation — pipeline.generate_article) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: defaults to pipeline.DEFAULT_TEXT_MODEL (google/gemini-2.5-flash-lite, same
# default the Pinterest pack uses for its own copy generation) if left unset.
OPENROUTER_TEXT_MODEL=

# --- apps/api (writes go through its /blog-posts endpoints, never direct DB access) ---
# Production API URL, e.g. https://api.sundera.app — this bot is cloud-hosted and talks to
# the deployed API, not a local one.
SUNDERA_API_BASE_URL=
# Must match BLOG_BOT_API_SECRET in apps/api's env exactly.
BLOG_BOT_API_SECRET=

# Daily check time + timezone offset (fixed, no DST) that bot.py proposes candidates at.
# Defaults shown. DAILY_PROPOSAL_COUNT is how many approved articles per day it stops at —
# apps/api spreads their actual publish times across the day independently (see
# BLOG_POSTS_PER_DAY/BLOG_PUBLISH_WINDOW_* in the root .env.example), this is just how many
# Telegram approval rounds happen per check.
CHECK_TIME=10:00
CHECK_UTC_OFFSET=3
DAILY_PROPOSAL_COUNT=3
