<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sundera.pinterest-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/antonk/Desktop/Projects/sundera-ai/marketing/pinterest/.venv/bin/python</string>
        <string>/Users/antonk/Desktop/Projects/sundera-ai/marketing/pinterest/bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/antonk/Desktop/Projects/sundera-ai/marketing/pinterest</string>

    <!-- Start immediately when this agent is loaded (covers login/reboot). -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart whenever bot.py exits, for any reason (crash, an unhandled exception,
         a Telegram getUpdates conflict, etc.) - as opposed to only restarting on a
         non-zero exit code. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Minimum seconds between respawns, so a persistent failure (e.g. a bad .env)
         throttles into a slow retry loop instead of spinning hot. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/antonk/Desktop/Projects/sundera-ai/marketing/pinterest/output/launchd/bot.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/antonk/Desktop/Projects/sundera-ai/marketing/pinterest/output/launchd/bot.err.log</string>
</dict>
</plist>
