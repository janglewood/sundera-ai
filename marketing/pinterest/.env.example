# Copy to marketing/pinterest/.env (gitignored) and fill in real values.
# Never commit this file with real secrets, and never paste real values into chat/PRs.

# --- OpenRouter (falls back to apps/api/.env if this is empty and that file exists) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=

# Text model for pin title/description generation (pipeline.generate_copy) — separate
# from OPENROUTER_MODEL above, which is the image-editing model. Optional: defaults to
# pipeline.DEFAULT_TEXT_MODEL (google/gemini-2.5-flash-lite) if left unset.
OPENROUTER_TEXT_MODEL=

# --- Cloudflare R2 (S3-compatible) ---
# Same bucket the app uses in prod (S3_BUCKET in the root .env.example), under a
# pinterest/ prefix. Endpoint is https://<account_id>.r2.cloudflarestorage.com.
# Use a scoped R2 API token (object read/write on this bucket only), not the
# account-wide Cloudflare API key.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Telegram approval bot (bot.py) ---
# Create via @BotFather (/newbot) for the token; message the bot once, then
# GET https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id
# out of the response. See marketing/pinterest/CLAUDE.md for the full steps.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily batch kickoff time, fixed UTC offset (no DST) — defaults shown.
SCHEDULE_TIME=11:00
SCHEDULE_UTC_OFFSET=3
BATCH_SIZE=3

# bot.py fetches before-photos from Pexels at startup rather than shipping
# them in the image/git (see refresh_photo_pool() in bot.py) — required for
# bot.py. Running pexels_collect.py manually still expects this exported in
# your shell (export PEXELS_API_KEY=...), not read from this file. Rotate
# if it's ever pasted somewhere outside an env file.
PEXELS_API_KEY=
PHOTO_POOL_SIZE=100
