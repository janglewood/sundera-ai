generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  firebaseUid   String   @unique
  email         String?  @unique
  emailVerified Boolean  @default(false)
  displayName   String?
  photoURL      String?
  provider      String?
  createdAt     DateTime @default(now())

  roomPhotos   RoomPhoto[]
  generations  Generation[]
  subscription Subscription?
}

model RoomPhoto {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  storageKey String
  mimeType   String
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  generations Generation[]

  @@index([userId])
}

enum RoomType {
  LIVING_ROOM
  BEDROOM
  KITCHEN
  BATHROOM
  OFFICE
  KIDS_ROOM
}

enum DesignStyle {
  MODERN
  SCANDINAVIAN
  MINIMALISM
  LOFT_INDUSTRIAL
  BOHO
  JAPANESE
  CLASSIC
  PROVENCE
  ART_DECO
  MID_CENTURY
  COASTAL
  FARMHOUSE
  MEDITERRANEAN
  ECLECTIC
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Generation {
  id           String            @id @default(cuid())
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  roomPhotoId  String
  roomPhoto    RoomPhoto         @relation(fields: [roomPhotoId], references: [id])
  roomType     RoomType
  style        DesignStyle
  customPrompt String?
  status       GenerationStatus  @default(PENDING)
  model        String
  errorMessage String?
  createdAt    DateTime          @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  sourceResultId String?
  sourceResult   GenerationResult? @relation("EditSource", fields: [sourceResultId], references: [id])

  results GenerationResult[] @relation("GenerationResults")

  @@index([status])
  @@index([userId])
  @@index([sourceResultId])
}

model GenerationResult {
  id           String     @id @default(cuid())
  generationId String
  generation   Generation @relation("GenerationResults", fields: [generationId], references: [id])
  storageKey   String
  index        Int
  createdAt    DateTime   @default(now())

  editsSourcedFromThis Generation[] @relation("EditSource")

  @@unique([generationId, index])
}

enum PlanTier {
  STARTER
  PRO
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
  FAILED
}

// Absence of a row means the user is on the FREE tier. lavaContractId is the
// lava.top *parent* contract id (the id returned from the first invoice) —
// renewals create separate child contracts but reference this one via
// parentContractId, and it's the id lava.top's cancel-subscription endpoint
// expects, so it must stay pinned to the original purchase, never a renewal.
model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id])
  planTier          PlanTier
  status            SubscriptionStatus @default(PENDING)
  periodicity       String
  lavaOfferId       String
  lavaContractId    String             @unique
  currentPeriodEnd  DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}
