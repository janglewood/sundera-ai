generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  firebaseUid   String   @unique
  email         String?  @unique
  emailVerified Boolean  @default(false)
  displayName   String?
  photoURL      String?
  provider      String?
  createdAt     DateTime @default(now())

  roomPhotos  RoomPhoto[]
  generations Generation[]
  purchase    Purchase?
}

model RoomPhoto {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  storageKey String
  mimeType   String
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  generations Generation[]

  @@index([userId])
}

enum RoomType {
  LIVING_ROOM
  BEDROOM
  KITCHEN
  BATHROOM
  OFFICE
  KIDS_ROOM
}

enum DesignStyle {
  MODERN
  SCANDINAVIAN
  MINIMALISM
  LOFT_INDUSTRIAL
  BOHO
  JAPANESE
  CLASSIC
  PROVENCE
  ART_DECO
  MID_CENTURY
  COASTAL
  FARMHOUSE
  MEDITERRANEAN
  ECLECTIC
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Generation {
  id           String            @id @default(cuid())
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  roomPhotoId  String
  roomPhoto    RoomPhoto         @relation(fields: [roomPhotoId], references: [id])
  roomType     RoomType
  style        DesignStyle
  customPrompt String?
  regionMask   Json?
  // Set only on the root Generation of an edit chain (sourceResultId == null) —
  // renaming resolves to the chain root so a custom name survives further edits.
  // See GenerationsService.findRootGenerationId / renameGeneration.
  title        String?
  status       GenerationStatus  @default(PENDING)
  model        String
  errorMessage String?
  createdAt    DateTime          @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  sourceResultId String?
  sourceResult   GenerationResult? @relation("EditSource", fields: [sourceResultId], references: [id])

  results GenerationResult[] @relation("GenerationResults")

  @@index([status])
  @@index([userId])
  @@index([sourceResultId])
}

model GenerationResult {
  id           String     @id @default(cuid())
  generationId String
  generation   Generation @relation("GenerationResults", fields: [generationId], references: [id])
  storageKey   String
  index        Int
  createdAt    DateTime   @default(now())

  editsSourcedFromThis Generation[] @relation("EditSource")

  @@unique([generationId, index])
}

enum PlanTier {
  LIFETIME
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
}

enum BlogPostStatus {
  SCHEDULED
  PUBLISHED
}

// Content for the auto-generated blog (marketing/blog/ bot writes these via
// POST /blog-posts). sourceImageKey is the R2 key of the Pinterest collage
// this article was built from — unique so the bot's dedup check (and the DB
// itself, as a backstop) never turns the same pin into two articles.
// scheduledFor is picked by BlogPostsService.create() to spread posts over
// the day; BlogPublishWorkerService flips SCHEDULED -> PUBLISHED when due.
model BlogPost {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  dek            String
  roomType       RoomType
  style          DesignStyle
  imageUrl       String
  imageAlt       String
  problems       Json
  palette        String
  materials      String
  lighting       String
  priceTable     Json
  faq            Json
  sourceImageKey String         @unique
  status         BlogPostStatus @default(SCHEDULED)
  scheduledFor   DateTime
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())

  @@index([status])
}

// Absence of a row means the user is on the FREE tier. A one-time purchase,
// so once status is COMPLETED the plan tier is entitled permanently — no
// period, cancellation, or expiry to track.
model Purchase {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id])
  planTier       PlanTier
  status         PurchaseStatus @default(PENDING)
  lavaOfferId    String
  lavaContractId String         @unique
  purchasedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}
